# Copy this file to .env (for local dev) and .env.test (for the test DB)
# and fill in real values. Never commit .env or .env.test.

# Supabase: Project Settings -> Database -> Connection string -> "URI"
# Use the connection pooler URI (port 6543) — but note Prisma needs the
# pgbouncer=true flag appended, since Supabase's pooler runs PgBouncer in
# transaction mode and Prisma otherwise tries to use prepared statements
# that mode doesn't support well (this can manifest as queries hanging
# rather than erroring). The direct connection (port 5432) also works
# without this flag if you'd rather use that instead.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"
