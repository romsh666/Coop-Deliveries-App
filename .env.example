# Copy this file to .env (for local dev) and .env.test (for the test DB)
# and fill in real values. Never commit .env or .env.test.

# Supabase: Project Settings -> Database -> Connection string -> "URI"
# (use the connection pooler URI, port 6543, for the app; the direct
# connection on port 5432 also works fine for a project this size)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET="replace-with-a-long-random-string"
